# Image registry that you can push to and workspace pods can pull from.
ORCA_IMAGE=quay.io/my-org/che-orca:latest
# Required: your Che user workspace namespace. Check it with `oc project -q`.
NAMESPACE=
# Image platform; linux/arm64 for CRC on Apple silicon.
# ORCA_PLATFORM=linux/amd64
# For manual editor registration; deploy.sh calculates this from its Route.
# ORCA_PAIRING_ADDRESS=wss://orca.example.com/
# Optional: one DevWorkspace per Orca workspace, in a separate agent namespace.
# Mirrors a proposed CheCluster spec.devAgentEnvironments section.
# ORCA_AGENT_NAMESPACE_TEMPLATE='<username>-agent-devspaces'
# Optional: a RuntimeClass already installed on the cluster, e.g. kata.
# ORCA_AGENT_RUNTIME_CLASS=kata
