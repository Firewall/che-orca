diff --git a/src/main/orcad/external-chromium-cdp-target.ts b/src/main/orcad/external-chromium-cdp-target.ts
new file mode 100644
index 00000000..28d7323d
--- /dev/null
+++ b/src/main/orcad/external-chromium-cdp-target.ts
@@ -0,0 +1,178 @@
+import { EventEmitter } from 'node:events'
+import { readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { BrowserError } from '../browser/browser-error'
+
+const CONNECT_TIMEOUT_MS = 10_000
+
+type PendingCommand = {
+  resolve: (value: unknown) => void
+  reject: (error: Error) => void
+}
+
+type CdpMessage = {
+  id?: unknown
+  method?: unknown
+  params?: unknown
+  result?: unknown
+  error?: { message?: unknown }
+}
+
+/**
+ * The slice of Electron's `webContents.debugger` the screencast engine uses, spoken over a
+ * DevTools page socket. Chromium accepts several clients per page, so this runs beside the
+ * agent-browser daemon that drives the same page.
+ */
+export class ExternalChromiumCdpDebugger extends EventEmitter {
+  private nextId = 1
+  private readonly pending = new Map<number, PendingCommand>()
+  private open = true
+
+  constructor(
+    private readonly socket: WebSocket,
+    private readonly onCrashChange: (crashed: boolean) => void
+  ) {
+    super()
+    socket.addEventListener('message', (event) => this.receive(event.data))
+    socket.addEventListener('close', () => this.close('target_closed'))
+  }
+
+  attach(): void {
+    // The socket is attached from the moment it opens.
+  }
+
+  isAttached(): boolean {
+    return this.open
+  }
+
+  detach(): void {
+    this.socket.close()
+    this.close('detached')
+  }
+
+  sendCommand(method: string, params: Record<string, unknown> = {}): Promise<unknown> {
+    if (!this.open) {
+      return Promise.reject(new Error('The browser page is no longer attached.'))
+    }
+    const id = this.nextId++
+    return new Promise((resolve, reject) => {
+      this.pending.set(id, { resolve, reject })
+      this.socket.send(JSON.stringify({ id, method, params }))
+    })
+  }
+
+  private receive(data: unknown): void {
+    if (typeof data !== 'string') {
+      return
+    }
+    let message: CdpMessage
+    try {
+      message = JSON.parse(data) as CdpMessage
+    } catch {
+      return
+    }
+    if (typeof message.id === 'number') {
+      const pending = this.pending.get(message.id)
+      if (!pending) {
+        return
+      }
+      this.pending.delete(message.id)
+      if (message.error) {
+        const detail = message.error.message
+        pending.reject(new Error(typeof detail === 'string' ? detail : 'CDP command failed.'))
+      } else {
+        pending.resolve(message.result ?? {})
+      }
+      return
+    }
+    if (typeof message.method !== 'string') {
+      return
+    }
+    if (message.method === 'Inspector.targetCrashed') {
+      this.onCrashChange(true)
+    } else if (message.method === 'Inspector.targetReloadedAfterCrash') {
+      this.onCrashChange(false)
+    }
+    // Same argument order as Electron's debugger 'message' event.
+    this.emit('message', {}, message.method, message.params ?? {})
+  }
+
+  private close(reason: string): void {
+    if (!this.open) {
+      return
+    }
+    this.open = false
+    for (const pending of this.pending.values()) {
+      pending.reject(new Error('The browser page closed.'))
+    }
+    this.pending.clear()
+    this.emit('detach', {}, reason)
+  }
+}
+
+/** Stands in for the Electron WebContents that `startBrowserScreencast` expects. */
+export class ExternalChromiumCdpTarget {
+  readonly debugger: ExternalChromiumCdpDebugger
+  private crashed = false
+
+  constructor(socket: WebSocket) {
+    this.debugger = new ExternalChromiumCdpDebugger(socket, (crashed) => {
+      this.crashed = crashed
+    })
+  }
+
+  isDestroyed(): boolean {
+    return !this.debugger.isAttached()
+  }
+
+  isCrashed(): boolean {
+    return this.crashed
+  }
+
+  close(): void {
+    this.debugger.detach()
+  }
+}
+
+/** Opens a CDP socket to one page of the Chromium that agent-browser launched on this profile. */
+export async function connectExternalChromiumCdpTarget(
+  profilePath: string,
+  targetId: string
+): Promise<ExternalChromiumCdpTarget> {
+  // Chromium writes the port it picked for --remote-debugging-port=0 to the profile directory.
+  const portFile = await readFile(join(profilePath, 'DevToolsActivePort'), 'utf8').catch(() => '')
+  const port = Number.parseInt(portFile.split('\n')[0] ?? '', 10)
+  if (!Number.isInteger(port) || port <= 0) {
+    throw new BrowserError(
+      'browser_screencast_unavailable',
+      'The browser did not publish a DevTools port.'
+    )
+  }
+  const socket = new WebSocket(`ws://127.0.0.1:${port}/devtools/page/${targetId}`)
+  await new Promise<void>((resolve, reject) => {
+    const timer = setTimeout(() => {
+      socket.close()
+      reject(new BrowserError('browser_timeout', 'Timed out connecting to the browser page.'))
+    }, CONNECT_TIMEOUT_MS)
+    socket.addEventListener(
+      'open',
+      () => {
+        clearTimeout(timer)
+        resolve()
+      },
+      { once: true }
+    )
+    socket.addEventListener(
+      'error',
+      () => {
+        clearTimeout(timer)
+        reject(new BrowserError('browser_tab_not_found', 'Could not connect to the browser page.'))
+      },
+      { once: true }
+    )
+  })
+  const target = new ExternalChromiumCdpTarget(socket)
+  // Only for the crash events; a page that refuses it still streams.
+  await target.debugger.sendCommand('Inspector.enable').catch(() => undefined)
+  return target
+}
