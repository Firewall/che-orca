index 00000000..b6abb852
--- /dev/null
+++ b/src/main/orcad/external-chromium-screencasts.ts
@@ -0,0 +1,301 @@
+import { randomUUID } from 'node:crypto'
+import type { WebContents } from 'electron'
+import type { BrowserScreencastResult } from '../../shared/runtime-types'
+import { startBrowserScreencast } from '../browser/browser-screencast-stream'
+import type {
+  BrowserScreencastSession,
+  BrowserScreencastViewport
+} from '../browser/browser-screencast-stream-types'
+import {
+  cdpPointerButtonMask,
+  normalizeCdpPointerButton,
+  type CdpPointerButton
+} from '../browser/agent-browser-bridge-mouse'
+import { imeFallbackKeyEvent, parseCdpKeyEvent } from '../browser/cdp-keyboard-us-layout'
+import {
+  normalizeScreencastFrameBudget,
+  normalizeScreencastViewport,
+  type BrowserScreencastParams,
+  type BrowserScreencastStartResult
+} from '../runtime/runtime-browser-commands-browser-command-target-params'
+import { sendRemoteBrowserScreencastFrame } from '../runtime/remote-browser-screencast-frame-admission'
+import {
+  connectExternalChromiumCdpTarget,
+  type ExternalChromiumCdpTarget
+} from './external-chromium-cdp-target'
+
+type ScreencastStream = {
+  sendBinary: (bytes: Uint8Array<ArrayBufferLike>) => boolean | void
+  emit?: (event: BrowserScreencastResult) => void
+}
+
+type Subscriber = ScreencastStream & {
+  pendingFrame: Uint8Array<ArrayBufferLike> | null
+  resolveDone: () => void
+}
+
+type PageStream = {
+  target: ExternalChromiumCdpTarget
+  format: 'jpeg' | 'png'
+  started: Promise<BrowserScreencastSession>
+  session: BrowserScreencastSession | null
+  subscribers: Map<string, Subscriber>
+  // The client sends a position with mouseMove only, so down/up/wheel land where it last moved.
+  pointer: { x: number; y: number; buttons: number }
+}
+
+/**
+ * Streams pages of the external Chromium to Orca clients with the desktop's screencast engine,
+ * and takes their pointer and keyboard input straight over CDP while they watch. Input through
+ * agent-browser costs a process launch per event, which made a click take a second.
+ */
+export class ExternalChromiumScreencasts {
+  private readonly streams = new Map<string, PageStream>()
+
+  constructor(private readonly profilePath: string) {}
+
+  async start(
+    page: { publicPageId: string; targetId: string },
+    tab: Record<string, unknown>,
+    params: BrowserScreencastParams,
+    stream: ScreencastStream
+  ): Promise<BrowserScreencastStartResult> {
+    const browserPageId = page.publicPageId
+    const subscriptionId = `browser-screencast:${browserPageId}:${randomUUID()}`
+    const viewport = normalizeScreencastViewport(params)
+    let resolveDone!: () => void
+    const done = new Promise<void>((resolve) => {
+      resolveDone = resolve
+    })
+    let active = this.streams.get(browserPageId)
+    if (!active) {
+      active = await this.open(browserPageId, page.targetId, params)
+    }
+    const record = active
+    record.subscribers.set(subscriptionId, { ...stream, pendingFrame: null, resolveDone })
+    let session: BrowserScreencastSession
+    try {
+      session = await record.started
+    } catch (error) {
+      record.subscribers.delete(subscriptionId)
+      resolveDone()
+      throw error
+    }
+    if (record.subscribers.size > 1 && viewport.viewportWidth && viewport.viewportHeight) {
+      await session.updateViewport(viewport)
+    }
+    return {
+      subscriptionId,
+      flushPendingFrame: () => {
+        const subscriber = record.subscribers.get(subscriptionId)
+        if (subscriber?.pendingFrame) {
+          const delivered = sendRemoteBrowserScreencastFrame(
+            subscriber.sendBinary,
+            subscriber.pendingFrame
+          )
+          subscriber.pendingFrame = delivered ? null : subscriber.pendingFrame
+        }
+      },
+      session: {
+        done,
+        stop: () => this.leave(browserPageId, record, subscriptionId),
+        updateViewport: (next: BrowserScreencastViewport) => session.updateViewport(next)
+      },
+      ready: { type: 'ready', subscriptionId, browserPageId, format: record.format, tab }
+    } as BrowserScreencastStartResult
+  }
+
+  isStreaming(browserPageId: string): boolean {
+    return this.streams.has(browserPageId)
+  }
+
+  /** Resizes a watched page; false when nobody is watching it. */
+  async updateViewport(
+    browserPageId: string,
+    viewport: BrowserScreencastViewport
+  ): Promise<boolean> {
+    const active = this.streams.get(browserPageId)
+    if (!active) {
+      return false
+    }
+    await (await active.started).updateViewport(viewport)
+    return true
+  }
+
+  /** Runs a watched page's pointer or key input over CDP; null when nobody is watching it. */
+  async input(
+    browserPageId: string,
+    method: string,
+    params: Record<string, unknown>
+  ): Promise<unknown> {
+    const active = this.streams.get(browserPageId)
+    if (!active) {
+      return null
+    }
+    await active.started
+    const send = (command: string, args: Record<string, unknown>): Promise<unknown> =>
+      active.target.debugger.sendCommand(command, args)
+    const pointer = active.pointer
+    switch (method) {
+      case 'browserMouseMove': {
+        pointer.x = Number(params.x)
+        pointer.y = Number(params.y)
+        await send('Input.dispatchMouseEvent', {
+          type: 'mouseMoved',
+          x: pointer.x,
+          y: pointer.y,
+          buttons: pointer.buttons
+        })
+        return { moved: { x: pointer.x, y: pointer.y } }
+      }
+      case 'browserMouseDown':
+      case 'browserMouseUp': {
+        const button: CdpPointerButton = normalizeCdpPointerButton(
+          typeof params.button === 'string' ? params.button : undefined
+        )
+        const pressed = method === 'browserMouseDown'
+        pointer.buttons = pressed
+          ? pointer.buttons | cdpPointerButtonMask(button)
+          : pointer.buttons & ~cdpPointerButtonMask(button)
+        await send('Input.dispatchMouseEvent', {
+          type: pressed ? 'mousePressed' : 'mouseReleased',
+          x: pointer.x,
+          y: pointer.y,
+          button,
+          buttons: pointer.buttons,
+          clickCount: 1
+        })
+        return pressed ? { down: button } : { up: button }
+      }
+      case 'browserMouseWheel': {
+        await send('Input.dispatchMouseEvent', {
+          type: 'mouseWheel',
+          x: pointer.x,
+          y: pointer.y,
+          deltaX: Number(params.dx ?? 0),
+          deltaY: Number(params.dy ?? 0)
+        })
+        return { wheel: { dx: params.dx ?? 0, dy: params.dy ?? 0 } }
+      }
+      case 'browserKeypress': {
+        const key = String(params.key ?? '')
+        const parsed = parseCdpKeyEvent(key) ?? imeFallbackKeyEvent(key)
+        if (!parsed) {
+          // Not in the key table; agent-browser knows more key names.
+          return null
+        }
+        const event = {
+          windowsVirtualKeyCode: parsed.keyCode,
+          nativeVirtualKeyCode: parsed.keyCode,
+          key: parsed.key,
+          code: parsed.code,
+          modifiers: parsed.modifiers,
+          location: parsed.location
+        }
+        await send('Input.dispatchKeyEvent', {
+          type: parsed.text === null ? 'rawKeyDown' : 'keyDown',
+          ...event,
+          ...(parsed.text === null ? {} : { text: parsed.text, unmodifiedText: parsed.text })
+        })
+        await send('Input.dispatchKeyEvent', {
+          type: 'keyUp',
+          ...event,
+          modifiers: parsed.modifiers & ~parsed.selfModifier
+        })
+        return { pressed: key }
+      }
+      default:
+        return null
+    }
+  }
+
+  stopAll(): void {
+    for (const active of this.streams.values()) {
+      active.session?.stop()
+      active.target.close()
+    }
+    this.streams.clear()
+  }
+
+  private async open(
+    browserPageId: string,
+    targetId: string,
+    params: BrowserScreencastParams
+  ): Promise<PageStream> {
+    const target = await connectExternalChromiumCdpTarget(this.profilePath, targetId)
+    // A concurrent subscriber may have opened the page while this one connected.
+    const raced = this.streams.get(browserPageId)
+    if (raced) {
+      target.close()
+      return raced
+    }
+    const subscribers = new Map<string, Subscriber>()
+    const record = {
+      target,
+      format: params.format,
+      session: null,
+      subscribers,
+      pointer: { x: 0, y: 0, buttons: 0 }
+    } as unknown as PageStream
+    record.started = startBrowserScreencast(target as unknown as WebContents, {
+      format: params.format,
+      ...normalizeScreencastFrameBudget(params),
+      ...normalizeScreencastViewport(params),
+      onFrame: (bytes) => {
+        for (const subscriber of subscribers.values()) {
+          const delivered = sendRemoteBrowserScreencastFrame(subscriber.sendBinary, bytes)
+          subscriber.pendingFrame = delivered ? null : bytes
+        }
+        return true
+      },
+      onEvent: (event) => {
+        for (const subscriber of subscribers.values()) {
+          subscriber.emit?.(event)
+        }
+      },
+      onError: (message) => {
+        for (const subscriber of subscribers.values()) {
+          subscriber.emit?.({ type: 'error', message })
+        }
+      }
+    })
+    this.streams.set(browserPageId, record)
+    void record.started
+      .then((session) => {
+        record.session = session
+        if (subscribers.size === 0) {
+          // Every viewer left while the stream was starting.
+          session.stop()
+        }
+        return session.done
+      })
+      .catch(() => undefined)
+      .finally(() => {
+        if (this.streams.get(browserPageId) === record) {
+          this.streams.delete(browserPageId)
+        }
+        target.close()
+        for (const subscriber of subscribers.values()) {
+          subscriber.resolveDone()
+        }
+        subscribers.clear()
+      })
+    return record
+  }
+
+  private leave(browserPageId: string, record: PageStream, subscriptionId: string): void {
+    const subscriber = record.subscribers.get(subscriptionId)
+    if (!subscriber) {
+      return
+    }
+    record.subscribers.delete(subscriptionId)
+    subscriber.resolveDone()
+    if (record.subscribers.size === 0) {
+      // The last viewer left; stop capturing and let the page run unwatched.
+      if (this.streams.get(browserPageId) === record) {
+        this.streams.delete(browserPageId)
+      }
+      record.session?.stop()
+    }
+  }
+}
